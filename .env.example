# If /api on the main domain does not reach Node (nginx static / wrong docroot), set the API origin and rebuild.
# Add that API origin + main site origin to CORS_ORIGIN in server/.env (comma-separated).
# VITE_API_BASE_URL=https://api.example.com
#
# After deploy, run: npm run verify:api-health  (must show JSON {"ok":true} — see HOSTING_PASSENGER.txt)
# Optional: enforce API base in CI — CHECK_PRODUCTION_API=1 npm run build

VITE_MAIL_API_URL=http://localhost:8787/api/send-inquiry
VITE_TURNSTILE_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=
# Set to false to hide trip listings, featured section, and trip navigation (default: visible)
VITE_SHOW_TRIPS=true

# Supabase (browser client uses anon key in src; URL is shared)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Required for Express /api/admin/* and server-side DB (service role — never expose to public client bundles)
# Same values can be set in server/.env instead; see server/.env.example
SUPABASE_SERVICE_ROLE_KEY=
