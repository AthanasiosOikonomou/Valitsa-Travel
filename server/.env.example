API_PORT=8787
# Comma-separated exact origins only (no wildcards)
CORS_ORIGIN=https://valitsatravel.gr,https://www.valitsatravel.gr

MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=your_email_password
MAIL_TO=info@yourdomain.com
# MAIL_CC=manager@yourdomain.com

# Configure one CAPTCHA provider secret (or both)
TURNSTILE_SECRET_KEY=your_turnstile_secret
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# Optional: persist inquiries to Supabase (service role — never expose to the client).
# You can set these in the project root .env (same as Vite) or in server/.env — both are loaded.
# SUPABASE_URL=https://xxxx.supabase.co
# Or reuse: VITE_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret  (from Supabase Dashboard → Settings → API)

