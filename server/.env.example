API_PORT=8787
# Comma-separated exact origins only (no wildcards). If the browser uses VITE_API_BASE_URL (Path B),
# include the marketing site origin here so fetch() from the main domain is allowed.
CORS_ORIGIN=https://valitsatravel.gr,https://www.valitsatravel.gr

# Optional: absolute URL for staff notification header image (e.g. dark logo). CID attachment used if unset and logo-dark.svg exists.
# MAIL_LOGO_URL=https://valitsatravel.gr/branding/navbar/logo-dark.svg

MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=your_email_password
# Visible From address (defaults to sales@valitsatravel.gr). SMTP still authenticates as MAIL_USER.
# If MAIL_USER is a different mailbox, the API sets the SMTP envelope sender to MAIL_USER so relay to guest addresses is allowed.
# MAIL_FROM=sales@valitsatravel.gr
MAIL_TO=info@yourdomain.com
# MAIL_CC=manager@yourdomain.com

# Configure one CAPTCHA provider secret (or both)
TURNSTILE_SECRET_KEY=your_turnstile_secret
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# Required for /api/admin/*, seasonal navigation, and inquiry persistence (service role — never expose to the client).
# Without URL + SUPABASE_SERVICE_ROLE_KEY, GET /api/seasonal-nav returns {"items":[]} (no navbar seasons).
# Set in project root .env and/or server/.env — both are loaded by server/index.js (root first, then server/.env).
# The API accepts either URL variable name:
#   VITE_SUPABASE_URL=https://xxxx.supabase.co
#   SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
# (Dashboard → Settings → API)
#
# If the seasonal_configs table is missing, run:
#   supabase/migrations/20260406120000_seasonal_navigation.sql
# in the Supabase SQL editor.

