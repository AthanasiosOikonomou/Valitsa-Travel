API_PORT=8787
# Comma-separated exact origins only (no wildcards)
CORS_ORIGIN=https://valitsatravel.gr,https://www.valitsatravel.gr

# Public site URL (no trailing slash). Used for confirmation email logo (logo-light.png or logo-light.svg) when unset below.
# PUBLIC_SITE_URL=https://valitsatravel.gr

# Optional: absolute URL for staff notification header image (e.g. dark logo). CID attachment used if unset and logo-dark.png exists.
# MAIL_LOGO_URL=https://valitsatravel.gr/branding/navbar/logo-dark.svg

# Optional: absolute URL for confirmation email logo only (overrides PUBLIC_SITE_URL + /branding/navbar/logo-light.png).
# MAIL_LOGO_CONFIRMATION_URL=https://valitsatravel.gr/branding/navbar/logo-light.png

MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=your_email_password
# From address for outbound mail (SMTP login remains MAIL_USER). Defaults to sales@valitsatravel.gr.
# MAIL_FROM=sales@valitsatravel.gr
MAIL_TO=info@yourdomain.com
# MAIL_CC=manager@yourdomain.com

# Configure one CAPTCHA provider secret (or both)
TURNSTILE_SECRET_KEY=your_turnstile_secret
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# Optional: persist inquiries to Supabase (service role — never expose to the client).
# You can set these in the project root .env (same as Vite) or in server/.env — both are loaded.
# SUPABASE_URL=https://xxxx.supabase.co
# Or reuse: VITE_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret  (from Supabase Dashboard → Settings → API)

