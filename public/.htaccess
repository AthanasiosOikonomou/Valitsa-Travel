<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let /api/* reach the backend before any -f/-d checks (avoids odd host edge cases).
  RewriteRule ^api(/|$) - [L]

  # Canonical home URL (avoid duplicate /index.html).
  RewriteRule ^index\.html$ / [R=301,L]

  # Do not rewrite real files or directories (assets, index.html, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA: serve React Router routes (/admin, /trips, …) from index.html (no redirect — keeps URL).
  # Pattern must match non-empty paths; "^" alone only matches the root path.
  RewriteRule . index.html [L]
</IfModule>

# Never cache index.html; it references hashed JS/CSS bundles

# and must always be fresh so users get the latest build.

<Files "index.html">
<IfModule mod_headers.c>
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</IfModule>
</Files>

# Long-term cache for Vite's hashed assets (JS, CSS, images, fonts).

# Safe because Vite changes the filename hash on every build.

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
