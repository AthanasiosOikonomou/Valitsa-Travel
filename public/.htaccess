# Hosting note:
# - Passenger + Node (root .htaccess with PassengerStartupFile): Express serves dist/ and
#   already falls back to index.html for paths like /admin/login — no mod_rewrite required.
# - Apache serving dist as static files only: the block below is needed so deep links work.
# - Nginx in front: .htaccess is ignored — try_files or proxy to Node (see deploy/nginx-spa-snippet.conf).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do NOT 301 /index.html -> / here. Nginx (try_files → /index.html) + Apache can loop:
  # internal /index.html request gets 301 to /, browser requests / again → endless 301.
  # Canonical URL is already set via <link rel="canonical"> in index.html.

  # Real files only (hashed bundles, images). Omit -d here: if a URL path matches a
  # directory on disk, skipping rewrite for "-d" can prevent falling through to index.html.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Let /api/* through to the backend (Passenger/Node or proxy); do not map to index.html.
  RewriteRule ^api(/|$) - [L]

  # SPA: serve React Router routes (/admin, /trips, …) from index.html (no redirect — keeps URL).
  RewriteRule ^ index.html [L]
</IfModule>

# Never cache index.html; it references hashed JS/CSS bundles

# and must always be fresh so users get the latest build.

<Files "index.html">
<IfModule mod_headers.c>
Header set Cache-Control "no-cache, no-store, must-revalidate"
Header set Pragma "no-cache"
Header set Expires "0"
</IfModule>
</Files>

# Long-term cache for Vite's hashed assets (JS, CSS, images, fonts).

# Safe because Vite changes the filename hash on every build.

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
