<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let ACME/CAA validation and similar well-known paths pass through untouched.
  RewriteRule ^\.well-known(?:/|$) - [L]

  # Let /api/* reach the backend before any -f/-d checks (avoids odd host edge cases).
  RewriteRule ^api(/|$) - [L]

  # SPA /admin/* before mod_dir sees a real admin/ folder on disk (often 301s to /admin/).
  RewriteCond %{REQUEST_URI} ^/admin(/.*)?$
  RewriteRule .* index.html [L]

  # Do not rewrite real files or directories (assets, index.html, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA: serve React Router routes (/admin, /trips, …) from index.html (no redirect — keeps URL).
  # Pattern must match non-empty paths; "^" alone only matches the root path.
  RewriteRule . index.html [L]
</IfModule>

# Never cache index.html; it references hashed JS/CSS bundles and must stay fresh.
<Files "index.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</Files>

# Long-term cache only for hashed Vite assets.
<IfModule mod_headers.c>
  <FilesMatch ".+-[A-Za-z0-9_-]{8,}\.(?:js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
