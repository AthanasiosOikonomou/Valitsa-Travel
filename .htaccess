# Phusion Passenger: load ESM server via CommonJS shim (see passenger_entry.cjs).
# Omit if your host sets the startup file only in the control panel.
<IfModule mod_passenger.c>
  PassengerAppType node
  PassengerStartupFile passenger_entry.cjs
</IfModule>

# SPA routes (/admin, /trips, …) and /api are handled by Node (server/index.js) once the
# request reaches Passenger. This minimal file avoids Apache/nginx edge cases that can
# mis-handle rewrites in front of Passenger.
